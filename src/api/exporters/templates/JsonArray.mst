{
	"frames": [
		{{#rects}}
		{
			"filename": "{{{name}}}",
			"frame": {
				"x": {{frame.x}},
				"y": {{frame.y}},
				"w": {{frame.w}},
				"h": {{frame.h}}
			},
			"rotated": {{rotated}},
			"trimmed": {{trimmed}},
			"spriteSourceSize": {
				"x": {{spriteSourceSize.x}},
				"y": {{spriteSourceSize.y}},
				"w": {{spriteSourceSize.w}},
				"h": {{spriteSourceSize.h}}
			},
			"sourceSize": {
				"w": {{sourceSize.w}},
				"h": {{sourceSize.h}}
			},
			{{#hasDuration}}
			"duration": {{duration}},
			{{/hasDuration}}
			"pivot": {
				"x": 0.5,
				"y": 0.5
			}
		}{{^last}},{{/last}}
		{{/rects}}
	],
	"meta": {
		"app": "{{{appInfo.url}}}",
		"version": "{{appInfo.version}}",
		"image": "{{^config.base64Export}}{{config.imageFile}}{{/config.base64Export}}{{#config.base64Export}}{{{config.base64Prefix}}}{{{config.imageData}}}{{/config.base64Export}}",
		"format": "{{config.format}}",
		"size": {
			"w": {{config.imageWidth}},
			"h": {{config.imageHeight}}
		},
		"scale": {{config.scale}}{{#meta.frameTags}},
		"frameTags": {{{.}}}{{/meta.frameTags}}{{#meta.layers}},
		"layers": {{{.}}}{{/meta.layers}}{{#meta.slices}},
		"slices": {{{.}}}{{/meta.slices}}
	}
}